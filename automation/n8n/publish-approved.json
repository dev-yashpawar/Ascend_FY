            "version": 2
          },
          "conditions": [
            {
              "id": "eligible",
              "leftValue": "={{ $json.data.eligible }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
